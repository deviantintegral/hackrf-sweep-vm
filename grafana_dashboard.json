{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "datasource", "uid": "grafana" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "title": "2.4GHz Spectrum Waterfall",
      "description": "Real-time spectrum view - darker = higher power",
      "type": "heatmap",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "hackrf_power_dbm_value",
          "legendFormat": "{{freq_mhz}} MHz",
          "refId": "A"
        }
      ],
      "options": {
        "calculate": false,
        "cellGap": 0,
        "color": {
          "exponent": 0.5,
          "fill": "dark-orange",
          "min": -100,
          "max": -40,
          "mode": "scheme",
          "reverse": false,
          "scale": "exponential",
          "scheme": "Turbo",
          "steps": 64
        },
        "yAxis": {
          "axisPlacement": "left",
          "reverse": false,
          "unit": "MHz"
        },
        "tooltip": {
          "show": true,
          "yHistogram": false
        },
        "legend": { "show": false }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "scaleDistribution": { "type": "linear" }
          }
        }
      }
    },
    {
      "title": "Zigbee Channel Power (Recommended: 15, 20, 25, 26)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "zigbee_channel_power_avg_value{channel=~\"15|20|25|26\"}",
          "legendFormat": "Ch {{channel}} avg",
          "refId": "A"
        },
        {
          "expr": "zigbee_channel_power_max_value{channel=~\"15|20|25|26\"}",
          "legendFormat": "Ch {{channel}} peak",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dB",
          "min": -100,
          "max": -40,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": -75 },
              { "color": "red", "value": -65 }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "title": "WiFi Channel Activity",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "wifi_channel_power_avg_value",
          "legendFormat": "WiFi Ch {{channel}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dB",
          "min": -100,
          "max": -40,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "fillOpacity": 20
          }
        }
      }
    },
    {
      "title": "Channel Utilization %",
      "description": "% of time above CCA threshold (-75 dBm)",
      "type": "gauge",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "zigbee_channel_utilization_value{channel=~\"15|20|25|26\"}",
          "legendFormat": "Ch {{channel}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 80 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      }
    },
    {
      "title": "Best Zigbee Channel",
      "description": "Channel with lowest interference",
      "type": "stat",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "bottomk(1, zigbee_channel_power_avg_value{channel=~\"15|20|25|26\"})",
          "legendFormat": "Channel {{channel}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [],
          "unit": "dB"
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": "/^Channel.*/"
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "auto"
      }
    },
    {
      "title": "Current Power Levels (All Zigbee Channels)",
      "type": "bargauge",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "zigbee_channel_power_avg_value",
          "legendFormat": "Ch {{channel}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dB",
          "min": -100,
          "max": -40,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": -75 },
              { "color": "red", "value": -65 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["lastNotNull"],
          "fields": ""
        },
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true
      }
    },
    {
      "title": "Monitor Health",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "hackrf_sweeps_per_interval_value",
          "legendFormat": "Sweeps/interval",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "green", "value": 25 }
            ]
          }
        }
      }
    },
    {
      "title": "Band Overview",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "targets": [
        {
          "expr": "hackrf_band_power_avg_value",
          "legendFormat": "Avg",
          "refId": "A"
        },
        {
          "expr": "hackrf_band_power_max_value",
          "legendFormat": "Max",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dB"
        }
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "tags": ["hackrf", "zigbee", "spectrum", "interference"],
  "templating": {
    "list": [
      {
        "current": {
          "selected": false,
          "text": "VictoriaMetrics",
          "value": "VictoriaMetrics"
        },
        "hide": 0,
        "includeAll": false,
        "label": "Data Source",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "queryValue": "",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "HackRF 2.4GHz Spectrum Monitor",
  "uid": "hackrf-zigbee-spectrum",
  "version": 1
}
